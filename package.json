{
  "name": "git-ai-commit",
  "version": "1.0.0",
  "type": "module",
  "license": "ISC",
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "eval": "echo \"No evals yet\" && exit 0",
    "lint:fix": "eslint . --fix",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.81",
    "ai": "^7.0.157",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1"
  }
}